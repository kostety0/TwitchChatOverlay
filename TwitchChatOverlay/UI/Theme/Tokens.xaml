<!--
    Design tokens — the single source of truth for colour, type and geometry.
    Style: Dark Mode (OLED), chosen because the app lives next to a game and OBS on a
    streamer's second monitor; a light window there is a flashbang.

    Accent deviates from the generic indigo of the reference palette in favour of Twitch
    purple: this is a Twitch tool and brand recognition beats palette purity.

    Contrast (WCAG AA) against Surface #16161F:
      TextPrimary   #F2F2F7 ≈ 15:1   body text            ✓ AAA
      TextSecondary #9A9AAE ≈ 6.2:1  hints, units         ✓ AA
      AccentText    #C4A2FF ≈ 7.4:1  links, active labels ✓ AAA
      Accent        #9146FF ≈ 2.9:1  fills and borders only — never small text
      TextOnAccent  #FFFFFF ≈ 5.8:1  on an accent fill    ✓ AA
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ============ Colour ============ -->
    <Color x:Key="BackgroundColor">#0E0E14</Color>
    <Color x:Key="SurfaceColor">#16161F</Color>
    <Color x:Key="SurfaceRaisedColor">#1D1D28</Color>
    <Color x:Key="BorderColor">#2A2A38</Color>
    <Color x:Key="BorderStrongColor">#3A3A4C</Color>

    <Color x:Key="TextPrimaryColor">#F2F2F7</Color>
    <Color x:Key="TextSecondaryColor">#9A9AAE</Color>
    <Color x:Key="TextDisabledColor">#5E5E70</Color>

    <Color x:Key="AccentColor">#9146FF</Color>
    <Color x:Key="AccentHoverColor">#A970FF</Color>
    <Color x:Key="AccentPressedColor">#7B31E8</Color>
    <Color x:Key="AccentTextColor">#C4A2FF</Color>
    <Color x:Key="AccentMutedColor">#2A1F45</Color>

    <Color x:Key="SuccessColor">#3FB950</Color>
    <Color x:Key="WarningColor">#E3A008</Color>
    <Color x:Key="DangerColor">#F85149</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}"/>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentTextColor}"/>
    <SolidColorBrush x:Key="AccentMutedBrush" Color="{StaticResource AccentMutedColor}"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>

    <!-- Semi-transparent state layers, so hover/press read the same over any surface. -->
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#FFFFFF" Opacity="0.06"/>
    <SolidColorBrush x:Key="PressedOverlayBrush" Color="#000000" Opacity="0.18"/>

    <!-- ============ Typography ============ -->
    <!-- Inter is the reference face; Segoe UI Variable / Segoe UI carry it on stock Windows
         so nothing has to be installed for the app to look right. -->
    <FontFamily x:Key="UiFontFamily">Inter, Segoe UI Variable Text, Segoe UI</FontFamily>

    <sys:Double x:Key="FontSizeCaption">11</sys:Double>
    <sys:Double x:Key="FontSizeBody">13</sys:Double>
    <sys:Double x:Key="FontSizeLabel">13</sys:Double>
    <sys:Double x:Key="FontSizeSection">14</sys:Double>
    <sys:Double x:Key="FontSizeTitle">18</sys:Double>
    <sys:Double x:Key="FontSizeDisplay">26</sys:Double>

    <!-- ============ Geometry ============ -->
    <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">6</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">10</CornerRadius>

    <!-- 4/8 spacing rhythm -->
    <Thickness x:Key="SpacingFieldGap">0,0,0,16</Thickness>
    <Thickness x:Key="SpacingSectionGap">0,24,0,10</Thickness>
    <Thickness x:Key="SpacingControlPadding">10,7</Thickness>
    <Thickness x:Key="SpacingPagePadding">20,16,20,20</Thickness>

    <!-- Micro-interactions stay in the 150–300 ms band; exits are shorter than entrances. -->
    <Duration x:Key="DurationFast">0:0:0.12</Duration>
    <Duration x:Key="DurationNormal">0:0:0.18</Duration>

</ResourceDictionary>
