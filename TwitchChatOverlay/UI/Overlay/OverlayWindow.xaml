<Window x:Class="TwitchChatOverlay.UI.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TwitchChatOverlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="420"
        Left="0"
        Top="0">
    <Border x:Name="CardBorder"
            Opacity="0"
            CornerRadius="12"
            Background="#CC14141C">
        <!-- The card sits over arbitrary game footage, so it carries its own contrast:
             a soft dark shadow keeps the edge readable on bright scenes. -->
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="4" Direction="270" Opacity="0.55" Color="Black"/>
        </Border.Effect>
        <Border.RenderTransform>
            <TranslateTransform x:Name="CardTranslate" X="0" Y="0"/>
        </Border.RenderTransform>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Accent stripe picks up the chatter's Twitch colour, which identifies the
                 speaker at a glance even when the card is read from across the room. -->
            <Border x:Name="AccentStripe" Grid.Column="0"
                    Width="4" CornerRadius="12,0,0,12"
                    Background="#9146FF"/>

            <StackPanel Grid.Column="1" Margin="14,12,16,13">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ItemsControl x:Name="BadgesPanel" Margin="0,0,8,0" Visibility="Collapsed">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#33FFFFFF" CornerRadius="3" Padding="5,1" Margin="0,0,4,0">
                                    <TextBlock Text="{Binding}" FontSize="10" FontWeight="SemiBold"
                                               Foreground="#FFFFFF"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="UsernameText"
                               FontFamily="Segoe UI"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="White"
                               TextWrapping="Wrap"
                               Text="Username"/>
                </StackPanel>

                <TextBlock x:Name="MessageText"
                           FontFamily="Segoe UI"
                           FontSize="15"
                           Foreground="#EDEDF2"
                           TextWrapping="Wrap"
                           LineHeight="21"
                           Margin="0,5,0,0"
                           Text="Message"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
